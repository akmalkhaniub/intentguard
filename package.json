{
  "name": "intentguard",
  "displayName": "IntentGuard: Autonomous AI Coding Control Plane & Rollback Suite",
  "description": "Real-time inline governance, blast-radius circuit breaker, intent adherence auditing, and 1-click rollback guard for Anthropic Claude Code, Google Antigravity, and OpenAI Codex.",
  "version": "0.8.0",
  "publisher": "akmalkhaniub",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/akmalkhaniub/intentguard"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "bin": {
    "intentguard": "./dist/cli.js",
    "ig": "./dist/cli.js"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "intentguard",
    "agentlens",
    "claude",
    "claude-code",
    "antigravity",
    "codex",
    "agent",
    "observability",
    "governance",
    "circuit-breaker",
    "git-rollback",
    "benchmarks",
    "gemini",
    "transcript"
  ],
  "activationEvents": [
    "onView:intentguard.sessionList",
    "onCommand:intentguard.openVisualizer",
    "onCommand:intentguard.refreshSessions",
    "onView:agentlens.sessionList",
    "onCommand:agentlens.openVisualizer",
    "onCommand:agentlens.refreshSessions",
    "onView:antigravity.sessionList",
    "onCommand:antigravity.openVisualizer",
    "onCommand:antigravity.refreshSessions",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "intentguard-sidebar",
          "title": "IntentGuard",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "intentguard-sidebar": [
        {
          "id": "intentguard.sessionList",
          "name": "Agent Sessions & Intent Guard"
        }
      ]
    },
    "commands": [
      {
        "command": "intentguard.openVisualizer",
        "title": "Open IntentGuard Cockpit",
        "category": "IntentGuard"
      },
      {
        "command": "intentguard.refreshSessions",
        "title": "Refresh Agent Sessions",
        "category": "IntentGuard",
        "icon": "$(refresh)"
      },
      {
        "command": "agentlens.openVisualizer",
        "title": "Open Dashboard (Legacy)",
        "category": "AgentLens"
      },
      {
        "command": "agentlens.refreshSessions",
        "title": "Refresh Sessions (Legacy)",
        "category": "AgentLens"
      },
      {
        "command": "antigravity.openVisualizer",
        "title": "Open Dashboard (Legacy)",
        "category": "AgentLens"
      },
      {
        "command": "antigravity.refreshSessions",
        "title": "Refresh Sessions (Legacy)",
        "category": "AgentLens"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "intentguard.refreshSessions",
          "when": "view == intentguard.sessionList",
          "group": "navigation"
        },
        {
          "command": "intentguard.refreshSessions",
          "when": "view == agentlens.sessionList",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile:ext": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "compile:cli": "esbuild ./src/cli/index.ts --bundle --outfile=dist/cli.js --format=cjs --platform=node --banner:js=\"#!/usr/bin/env node\"",
    "compile:action": "esbuild ./action/index.ts --bundle --outfile=dist/action.js --format=cjs --platform=node",
    "compile": "npm run compile:ext && npm run compile:cli && npm run compile:action",
    "watch": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  }
}
